{
  "name": "seismo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "contracts",
    "sdk-node",
    "backend",
    "github-app",
    "services"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "setup": "bash scripts/dev/setup.sh",
    "dev": "bash scripts/dev/dev.sh",
    "gh:register": "node --env-file=.env scripts/dev/register-github-app.mjs",
    "db:migrate": "npm run db:migrate -w backend",
    "e2e": "turbo run test",
    "demo:traffic": "node --env-file=.env scripts/dev/demo-traffic.mjs",
    "demo:reset": "node --env-file=.env scripts/dev/demo-reset.mjs",
    "demo:online": "node --env-file=.env scripts/demo/online.mjs",
    "verify:pipeline": "node --env-file=.env scripts/verify/pipeline.mjs",
    "deploy:render": "node --env-file=.env scripts/deploy/render.mjs",
    "github:webhook": "node --env-file=.env scripts/deploy/github-webhook.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "playwright": "^1.64.0",
    "prettier": "^3.3.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.12.1"
}
