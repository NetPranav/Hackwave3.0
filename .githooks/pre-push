#!/usr/bin/env bash
# Local guard: you may push only your own personal branch (and team-status via scripts).
# Installed by scripts/setup.sh (git config core.hooksPath .githooks).
me=$(git config --get seismo.handle || true)
mine=$(printf '%s' "$me" | tr '[:upper:]' '[:lower:]')
zero="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
  name=${remote_ref#refs/heads/}
  [ "$name" = "$remote_ref" ] && continue          # tags: allowed
  [ "$local_sha" = "$zero" ] && continue           # deleting: allowed (GitHub guards main)
  case "$name" in
    main)
      echo "✋ Nobody pushes to 'main'. The lead merges personal branches into main through a PR." >&2; exit 1 ;;
    team-status)
      ;;                                           # used by scripts/team-*.sh
    "$mine")
      ;;                                           # your own branch
    netpranav|adarzhpathade|overxpowered)
      echo "✋ '$name' is someone else's branch. Push only to '$mine'. Need something from them? bash scripts/team-request.sh" >&2; exit 1 ;;
    *)
      echo "✋ Push only to your own branch '$mine' (got '$name'). See CONTRIBUTING.md." >&2; exit 1 ;;
  esac
done
exit 0
