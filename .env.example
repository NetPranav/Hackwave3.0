# Copy to .env (git-ignored) and fill in. Never commit real values.
DATABASE_URL=postgres://localhost:5432/seismo

# Backend
PORT=4000
SEISMO_SDK_KEYS=dev-key
# the one project this deployment watches
SEISMO_PROJECT=dev
# GitHub logins allowed to manage SDK keys (comma-separated); empty = first signed-in user claims the project
SEISMO_PROJECT_OWNERS=
# fingerprints accepted per project per minute (above: 429 + Retry-After)
INGEST_RATE_PER_MIN=1200
# shared with the dashboard (Auth.js) so the backend can verify sessions
AUTH_SECRET=
DEMO_ADMIN_TOKEN=dev-admin

# AI (NVIDIA NIM)
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# Explainer + judge model. Tested 2026-10-11: Super gives valid JSON in ~3-6 s; Ultra ignores response_format on the
# hosted API and loops until max_tokens, so it is not used by default.
NIM_MODEL_EXPLAIN=nvidia/nemotron-3-super-120b-a12b
NIM_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b

# GitHub App (npm run gh:register writes these)
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# your smee.io channel
WEBHOOK_PROXY_URL=

# Alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Trial Twilio accounts cannot send free text on WhatsApp (error 21654): put the HX… id of a template from
# Console -> Messaging -> Try it out -> Send a WhatsApp message here, and every alert sends that template as a ping.
# After upgrading the account, leave it empty and use the WhatsApp Sandbox (whatsapp:+14155238886) for full alert text.
TWILIO_WHATSAPP_CONTENT_SID=
# If that template has variables, fill them: placeholders {change} {link} {service} {title} {severity} {pr} {repo}
# ({link} = the fix PR once it is open, else the repository). Example: {"1":"{change}","2":"{link}"}
TWILIO_WHATSAPP_CONTENT_VARIABLES=
# Your WhatsApp number is set in the dashboard (Settings > WhatsApp) and stored in Postgres.
# TWILIO_TO=whatsapp:+91... only seeds a fresh database.
# Email, option A (free, any recipient): Gmail SMTP with an app password (Google Account > Security > App passwords)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Email, option B: Resend (free plan without a verified domain sends ONLY to your own Resend account email)
RESEND_API_KEY=
# the only repo the demo reset may touch (closes Seismo PRs, empties seismo/aliases.json)
DEMO_REPO=
