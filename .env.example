# Copy to .env (git-ignored) and fill in. Never commit real values.
DATABASE_URL=postgres://localhost:5432/seismo

# Backend
PORT=4000
SEISMO_SDK_KEYS=dev-key
AUTH_SECRET=                 # shared with the dashboard (Auth.js) so the backend can verify sessions
DEMO_ADMIN_TOKEN=dev-admin

# AI (NVIDIA NIM)
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL_SMART=nvidia/nemotron-3-ultra-550b-a55b
NIM_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b

# GitHub App (npm run gh:register writes these)
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
WEBHOOK_PROXY_URL=           # your smee.io channel

# Alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
RESEND_API_KEY=
