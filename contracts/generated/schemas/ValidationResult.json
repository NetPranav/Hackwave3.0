{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "driftId": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "C1",
              "C2",
              "C3",
              "C4",
              "C5",
              "C6",
              "C7",
              "C8"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "passed"
        ],
        "additionalProperties": false
      }
    },
    "ci": {
      "type": "string",
      "enum": [
        "pending",
        "green",
        "red"
      ]
    },
    "prUrl": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "driftId",
    "checks",
    "ci"
  ],
  "additionalProperties": false
}