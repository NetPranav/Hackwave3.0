{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "deprecation",
        "sunset",
        "changelog",
        "breaking",
        "spec"
      ]
    },
    "changeType": {
      "default": "other",
      "type": "string",
      "enum": [
        "rename",
        "removal",
        "type",
        "units",
        "limit",
        "pagination",
        "deprecation",
        "enum",
        "other"
      ]
    },
    "date": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "sourceUrl": {
      "type": "string"
    },
    "quote": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "field": {
      "type": "string"
    },
    "matchedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "default": "info",
      "type": "string",
      "enum": [
        "info",
        "warning",
        "breaking"
      ]
    },
    "suggestion": {
      "default": "",
      "type": "string"
    },
    "extractedBy": {
      "default": "rules",
      "type": "string",
      "enum": [
        "ai",
        "rules",
        "header",
        "spec"
      ]
    },
    "driftEventId": {
      "type": "string"
    },
    "detectedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "service",
    "title",
    "kind",
    "changeType",
    "source",
    "matchedFiles",
    "severity",
    "suggestion",
    "extractedBy"
  ],
  "additionalProperties": false
}