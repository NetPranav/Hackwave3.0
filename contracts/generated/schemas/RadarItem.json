{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "deprecation",
        "sunset",
        "changelog",
        "breaking"
      ]
    },
    "date": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "matchedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "id",
    "service",
    "title",
    "kind",
    "source",
    "matchedFiles"
  ],
  "additionalProperties": false
}