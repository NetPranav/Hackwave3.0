{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "driftId": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "rung": {
      "type": "string",
      "enum": [
        "alias",
        "transform",
        "behaviour"
      ]
    },
    "rule": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "default": "alias",
          "type": "string",
          "const": "alias"
        },
        "endpoint": {
          "type": "string"
        },
        "path": {
          "default": "$",
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "driftEvent": {
          "type": "string"
        },
        "addedAt": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "endpoint",
        "path",
        "target",
        "source"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "driftId",
    "repo",
    "rung"
  ],
  "additionalProperties": false
}