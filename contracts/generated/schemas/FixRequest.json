{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "driftId": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "rung": {
      "type": "string",
      "enum": [
        "alias",
        "transform",
        "behaviour"
      ]
    },
    "rule": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "default": "alias",
              "type": "string",
              "const": "alias"
            },
            "endpoint": {
              "type": "string"
            },
            "path": {
              "default": "$",
              "type": "string"
            },
            "target": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "driftEvent": {
              "type": "string"
            },
            "addedAt": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "endpoint",
            "path",
            "target",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "scale"
            },
            "endpoint": {
              "type": "string"
            },
            "path": {
              "default": "$",
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "divideBy": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "driftEvent": {
              "type": "string"
            },
            "addedAt": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "endpoint",
            "path",
            "field",
            "divideBy"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "driftId",
    "repo",
    "rung"
  ],
  "additionalProperties": false
}