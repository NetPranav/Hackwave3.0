{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "normal",
              "suspected",
              "breaking",
              "fix_pending",
              "resolved",
              "expected",
              "snoozed"
            ]
          },
          "provider": {
            "type": "string",
            "enum": [
              "operational",
              "degraded",
              "outage",
              "unknown"
            ]
          },
          "callsPerMin": {
            "type": "number"
          },
          "errorRate": {
            "type": "number"
          },
          "p95Ms": {
            "type": "number"
          },
          "lastSeen": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "upcomingChange": {
            "type": "string"
          },
          "sparkline": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "endpoint": {
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "normal",
                    "suspected",
                    "breaking",
                    "fix_pending",
                    "resolved",
                    "expected",
                    "snoozed"
                  ]
                },
                "callsPerMin": {
                  "type": "number"
                },
                "errorRate": {
                  "type": "number"
                },
                "p95Ms": {
                  "type": "number"
                },
                "rate429": {
                  "type": "number"
                },
                "fieldsMapped": {
                  "type": "number"
                }
              },
              "required": [
                "endpoint",
                "method",
                "state",
                "callsPerMin",
                "errorRate",
                "p95Ms",
                "rate429",
                "fieldsMapped"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "service",
          "state",
          "provider",
          "callsPerMin",
          "errorRate",
          "p95Ms",
          "lastSeen",
          "sparkline",
          "endpoints"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "services"
  ],
  "additionalProperties": false
}