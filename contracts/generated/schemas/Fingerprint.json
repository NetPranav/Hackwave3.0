{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "sdkKeyId": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "endpoint": {
      "type": "string"
    },
    "status": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "latencyMs": {
      "type": "number"
    },
    "count": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "windowStart": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "windowSeconds": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "headers": {
      "type": "object",
      "properties": {
        "deprecation": {
          "type": "string"
        },
        "sunset": {
          "type": "string"
        },
        "rateLimitRemaining": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "types": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "number"
            }
          },
          "presence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "formatClass": {
            "type": "string"
          },
          "lengthBuckets": {
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "magnitude": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "percentiles": {
            "type": "object",
            "properties": {
              "p10": {
                "type": "number"
              },
              "p50": {
                "type": "number"
              },
              "p90": {
                "type": "number"
              }
            },
            "required": [
              "p10",
              "p50",
              "p90"
            ],
            "additionalProperties": false
          },
          "enumValues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "saltedHashes": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "types",
          "presence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "sdkKeyId",
    "service",
    "method",
    "endpoint",
    "status",
    "latencyMs",
    "count",
    "windowStart",
    "windowSeconds",
    "fields"
  ],
  "additionalProperties": false
}