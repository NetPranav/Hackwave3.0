{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "choice": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    }
  },
  "required": [
    "choice",
    "confidence",
    "reason"
  ],
  "additionalProperties": false
}