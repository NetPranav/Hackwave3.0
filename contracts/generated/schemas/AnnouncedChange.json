{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "endpoint": {
      "type": "string",
      "maxLength": 200
    },
    "field": {
      "type": "string",
      "maxLength": 120
    },
    "changeType": {
      "type": "string",
      "enum": [
        "rename",
        "removal",
        "type",
        "units",
        "limit",
        "pagination",
        "deprecation",
        "enum",
        "other"
      ]
    },
    "effectiveDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "summary": {
      "type": "string",
      "minLength": 5,
      "maxLength": 300
    },
    "quote": {
      "type": "string",
      "minLength": 5,
      "maxLength": 500
    }
  },
  "required": [
    "changeType",
    "summary",
    "quote"
  ],
  "additionalProperties": false
}